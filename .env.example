# ── Database ──
# Local dev (SQLite — default, no setup needed)
# DATABASE_URL=sqlite+aiosqlite:///./rsud.db

# Production (PostgreSQL — uncomment and adjust)
DATABASE_URL=postgresql+asyncpg://rsud:rsud_secret@localhost:5433/rsud

# Docker Compose overrides
POSTGRES_PASSWORD=rsud_secret
PG_PORT=5433
BACKEND_PORT=8100
FRONTEND_PORT=8080
# .local is a special-use domain; pgAdmin allows it via PGADMIN_CONFIG_ALLOW_SPECIAL_EMAIL_DOMAINS (set in compose)
PGADMIN_EMAIL=admin@rsud.local
PGADMIN_PASSWORD=rsud_admin
PGADMIN_PORT=5050

# ── JWT / Auth ──
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Storage ──
UPLOAD_DIR=uploads

# ── SQLAlchemy (optional) ──
# SQLALCHEMY_URL=postgresql+asyncpg://rsud:rsud_secret@localhost:5433/rsud
